{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "ENABLE_EXPERIMENTAL_COREPACK",
        "DYRECTED_URL",
        "DYRECTED_API_KEY",
        "DYRECTED_SITE_ID",
        "NEXT_PUBLIC_DYRECTED_API_KEY",
        "NEXT_PUBLIC_DYRECTED_SITE_ID",
        "NEXT_PUBLIC_DYRECTED_URL",
        "NUXT_PUBLIC_DYRECTED_API_KEY",
        "NUXT_PUBLIC_DYRECTED_SITE_ID",
        "NUXT_PUBLIC_DYRECTED_URL",
        "VITE_DYRECTED_API_KEY",
        "VITE_DYRECTED_SITE_ID",
        "VITE_DYRECTED_URL"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        ".output/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {}
  },
  "concurrency": "20"
}
