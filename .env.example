# -----------------------------------------------------------------------------
# Dyrected Monorepo - Environment Configuration Example
# Copy this file to .env and update the values for your local environment.
# -----------------------------------------------------------------------------

# --- Database Configuration ---
# Used by @dyrected/db-* adapters
DATABASE_URL="postgres://postgres:password@localhost:5432/dyrected"
MONGODB_URL="mongodb://localhost:27017/dyrected"

# --- Authentication & Security ---
# Secret for signing JWTs (if applicable)
JWT_SECRET="your-super-secret-jwt-key"
# Key for sensitive data encryption
ENCRYPTION_KEY="your-32-character-encryption-key"
# Your Dyrected license key for self-hosted instances
DYRECTED_LICENSE_KEY="dy_..."

# --- API Configuration ---
# The base URL where your Dyrected core API is running
DYRECTED_URL="http://localhost:3000"
# Your Site API Key (generated in the Admin UI)
DYRECTED_API_KEY="site_..."

# --- Storage: Amazon S3 / Compatible (Cloudflare R2, Backblaze S3) ---
# Used by @dyrected/storage-s3
S3_BUCKET="dyrected-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_ENDPOINT="" # Optional: for non-AWS S3 providers

# --- Storage: Backblaze B2 (Native) ---
# Used by @dyrected/storage-b2
B2_KEY_ID="your-key-id"
B2_APP_KEY="your-application-key"
B2_BUCKET="your-bucket-name"

# --- Storage: Cloudinary ---
# Used by @dyrected/storage-cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Framework Integration: Next.js ---
# Used by @dyrected/next
NEXT_PUBLIC_APP_URL="http://localhost:4001"
NEXT_PUBLIC_DYRECTED_API_KEY="site_..."

# --- Framework Integration: Nuxt ---
# Used by @dyrected/nuxt
NUXT_PUBLIC_APP_URL="http://localhost:4002"
NUXT_PUBLIC_DYRECTED_API_KEY="site_..."

# --- Third-Party Services ---
# Email (Seamailer)
SEAMAILER_API_KEY="your-seamailer-key"
# Cache (Redis)
REDIS_URL="redis://localhost:6379"

# --- Development ---
# Set to 'debug' for more verbose logging in @dyrected/core
DEBUG=dyrected:*
