{
  "name": "dyrected",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo build --filter='./packages/*'",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "version:packages": "changeset version && node scripts/sync-changelog.mjs",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "release": "pnpm build:packages && changeset publish",
    "release:snapshot": "pnpm build:packages && changeset publish --no-git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "jiti": "^1.21.0",
    "turbo": "^2.9.9",
    "typescript": "latest"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "pnpm": {
    "overrides": {
      "hono": "4.12.27",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3"
    }
  }
}
