{
  "name": "@dyrected/sdk",
  "version": "2.5.8",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "qs": "^6.12.1"
  },
  "devDependencies": {
    "@dyrected/core": "workspace:*",
    "@types/qs": "^6.15.1",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5",
    "vitest": "^1.0.0"
  },
  "license": "BSL-1.1",
  "author": "Busola Okeowo <busolaokemoney@gmail.com>",
  "homepage": "https://dyrected.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dyrected/dyrected.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Client-side SDK for Dyrected CMS"
}
