{
  "name": "@dyrected/next",
  "version": "2.5.29",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && cp dist-cjs/config.js dist/config.cjs && cp ../admin/dist/admin.css dist/admin.css && rm -rf dist-cjs",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "next": ">=13.4.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs",
      "default": "./dist/config.cjs"
    },
    "./styles": "./dist/admin.css"
  },
  "dependencies": {
    "@dyrected/core": "workspace:*",
    "@dyrected/react": "workspace:*",
    "@dyrected/sdk": "workspace:*",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "next": "^14.2.3",
    "typescript": "^5.4.5"
  },
  "license": "BSL-1.1",
  "author": "Busola Okeowo <busolaokemoney@gmail.com>",
  "homepage": "https://dyrected.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dyrected/dyrected.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Next.js integration for Dyrected CMS"
}
